<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    tools:context=".HelpFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0.6"/>
    <Button
        android:id="@+id/voltar"
        android:layout_width="170dp"
        android:layout_height="51dp"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="70dp"
        android:layout_marginEnd="90dp"
        android:text="voltar para inicio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tentardnv"
        app:layout_constraintEnd_toEndOf="parent"
        app:icon="?attr/homeAsUpIndicator" />
    <Button
        android:id="@+id/tentardnv"
        android:layout_width="170dp"
        android:layout_height="71dp"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="70dp"
        android:layout_marginStart="90dp"
        android:text="Tentar de novo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/voltar"
        app:icon="?attr/homeAsUpIndicator" />

    <TextView
        android:id="@+id/txtfim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:layout_marginStart="10dp"
        android:text="Fim da partida"
        android:textColor="@color/white"
        android:textSize="54sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:id="@+id/txtparabens"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parabéns, sua maior sequencia foi: "
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="30dp"
        app:layout_constraintTop_toBottomOf="@id/txtfim"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/sequencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="numero"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="30dp"
        app:layout_constraintTop_toBottomOf="@id/txtparabens"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:id="@+id/nav_view"
        app:menu="@menu/nav_menu"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="#03A9F4"
        app:itemTextColor="#2196F3"/>

</androidx.constraintlayout.widget.ConstraintLayout>